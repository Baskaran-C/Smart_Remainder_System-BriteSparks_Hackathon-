# ============================================================
# SECRETS TEMPLATE — copy this file to application-secrets.properties
# and fill in your own credentials before running.
#
# See README.md → "Configuration" section for full instructions.
# ============================================================

# MySQL password (default root password for local setup)
spring.datasource.password=YOUR_MYSQL_ROOT_PASSWORD

# Brevo SMTP credentials
# Sign up free at https://brevo.com → SMTP & API → SMTP tab
spring.mail.username=YOUR_BREVO_SMTP_LOGIN@smtp-brevo.com
spring.mail.password=YOUR_BREVO_SMTP_KEY
